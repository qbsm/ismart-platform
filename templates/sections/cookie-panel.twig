{# Панель согласия на cookie (proposal 0025). Текст и кнопка — из global.json → cookie-panel,
   у каждой площадки свои. Кнопка одна — «Принять» (решение владельца 19.10.2026): согласие —
   это нажатие, а кто не нажал, с того ничего не собираем — счётчики и маячок ждут «Принять»
   (consent-gate.twig). Панель висит, пока согласия нет. #}
{% set cookiePanel = global['cookie-panel'][lang_code] | default({}) %}
{% set acceptClass = cookiePanel.button.class | default('button button-sm outline-color-2 uppercase nowrap js-cookie') %}
<section class="cookie-panel hidden" style="display: none;" aria-hidden="true" aria-label="{{ cookiePanel.label | default('Согласие на cookie') }}">
  <div class="container-sm">
    <div class="section__item">
      <div class="section__subitem desc-wrap">
        <span class="desc">{{ cookiePanel.desc | default('Мы используем файлы cookie, чтобы сайт работал корректно, а также для аналитики. Нажимая «Принять», вы соглашаетесь на их использование.') | raw }}</span>
      </div>
      <div class="section__subitem button-wrap">
        <button type="button" class="{{ acceptClass }}">{{ cookiePanel.button.title | default('Принять') }}</button>
      </div>
    </div>
  </div>
</section>

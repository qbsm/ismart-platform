{# Маячок сессий формы и виджета CallTouch (proposals 0023, 0024). Нарочно inline и отдельно
   от бандла: обязан пережить смерть JS. Ключ сессии кладётся скрытым полем idempotency_key —
   бандл шлёт его как есть, приёмник сшивает попытку с заявкой. Номер уходит, как только
   цифр хватает; каждая версия — со своим seq; события копятся пачками. #}
<script>
(function () {
  if (window.__ismartAttempt) return;
  var EP = 'https://api.ismart.pro/v1/attempt';
  var SEND_RE = /\/api\/(send|widget-rescue)/;
  var PHONE_RE = /тел|phone/i;
  var NAME_RE = /имя|name/i;
  var TRAP = ['company_site', 'website'];
  var FLUSH_MS = 5000;
  var DEBOUNCE_MS = 500;
  var CLICK_KEY = 'ct_opened_by_click';
  var CLICK_WINDOW_MS = 600000;
  var t0 = Date.now();
  var lastPointer = 0;
  var state = { version: 3, last: null, sessions: [] };
  window.__ismartAttempt = state;

  function sec() { return Math.round((Date.now() - t0) / 100) / 10; }
  function hex() {
    try { if (window.crypto && crypto.randomUUID) return crypto.randomUUID().replace(/-/g, ''); } catch (e) {}
    var s = '';
    while (s.length < 32) s += Math.floor(Math.random() * 16).toString(16);
    return s;
  }
  function visitor() {
    try {
      var v = localStorage.getItem('ismart_visitor');
      if (!v) { v = hex(); localStorage.setItem('ismart_visitor', v); }
      return v;
    } catch (e) { return ''; }
  }
  function digitsOf(v) { return String(v || '').replace(/\D+/g, ''); }
  function ready(d) { return d.length >= (/^[78]/.test(d) ? 11 : 10); }
  function cookie(name) {
    var m = document.cookie.match(new RegExp('(?:^|; )' + name + '=([^;]*)'));
    return m ? decodeURIComponent(m[1]) : '';
  }
  function openedByClick() {
    try {
      var at = Number(sessionStorage.getItem(CLICK_KEY) || 0);
      return at > 0 && Date.now() - at <= CLICK_WINDOW_MS;
    } catch (e) { return false; }
  }
  function post(body) {
    try {
      var b = JSON.stringify(body);
      if (navigator.sendBeacon) navigator.sendBeacon(EP, new Blob([b], { type: 'text/plain' }));
      else if (window.fetch) fetch(EP, { method: 'POST', body: b, keepalive: true });
    } catch (e) {}
  }
  function value(root, selector) {
    var i = root.querySelector(selector);
    return i && i.value ? String(i.value).trim() : '';
  }

  function session(root, channel, id) {
    if (root.__ismartSession) return root.__ismartSession;
    var s = { id: id || hex(), channel: channel, root: root, buf: [], timer: null, seq: 0, key: '',
      ready: false, input: 'typed', inputAt: 0, debounce: null, started: false, open: false, focused: false };
    root.__ismartSession = s;
    state.sessions.push(s);
    return s;
  }
  function active(s) { return s.started || s.seq > 0; }
  function drop(s) {
    flush(s);
    delete s.root.__ismartSession;
    state.sessions = state.sessions.filter(function (x) { return x !== s; });
  }
  function push(s, ev, immediate) {
    ev.t = sec();
    s.buf.push(ev);
    if (immediate) flush(s);
    else if (active(s) && !s.timer) s.timer = setTimeout(function () { flush(s); }, FLUSH_MS);
  }
  function flush(s) {
    if (s.timer) { clearTimeout(s.timer); s.timer = null; }
    if (!s.buf.length || !active(s)) return;
    var events = s.buf;
    s.buf = [];
    post({ session_id: s.id, channel: s.channel, page_url: location.href, events: events });
  }
  function begin(s, extra) {
    if (s.started) return;
    s.started = true;
    var ev = { kind: 'form_start', referrer: String(document.referrer || '').slice(0, 300), vw: window.innerWidth, visitor: visitor() };
    if (extra) for (var k in extra) ev[k] = extra[k];
    push(s, ev, true);
  }
  function schedule(s, fn) {
    if (s.debounce) clearTimeout(s.debounce);
    s.debounce = setTimeout(function () { s.debounce = null; fn(); }, DEBOUNCE_MS);
  }
  /* Способ ввода: Chrome при автозаполнении шлёт input вообще без inputType, поэтому одного
     типа события мало — смотрим ещё на прирост длины. Человек набирает по символу. */
  function noteInput(s, e, len) {
    var grew = len - (s.len || 0);
    s.len = len;
    if (e.type === 'input') {
      s.inputAt = Date.now();
      var it = e.inputType || '';
      if (it === 'insertFromPaste') s.input = 'paste';
      else if (it === 'insertReplacementText') s.input = 'autofill';
      else if (!it && grew > 1) s.input = 'autofill';
      else if (grew > 1) s.input = 'paste';
      else s.input = 'typed';
    } else if (e.type === 'change' && Date.now() - s.inputAt > 300) {
      s.input = 'autofill';
    }
  }
  function evalTouch(s, fields, trap) {
    var d = fields.phone;
    if (ready(d)) {
      var key = [d, fields.name, fields.email, fields.policy].join('|');
      if (key === s.key) return;
      s.key = key;
      s.ready = true;
      push(s, { kind: 'touch', seq: ++s.seq, fields: fields, input: s.input, trap: trap || '',
        ct_session_id: cookie('_ct_session_id'), ym_uid: cookie('_ym_uid') }, true);
      return;
    }
    if (s.ready) {
      s.ready = false;
      s.key = '';
      push(s, { kind: 'retract', seq: ++s.seq, digits: d.length }, true);
    }
  }
  function focusPhone(s) {
    if (s.focused) return;
    s.focused = true;
    push(s, { kind: 'phone_focus' });
  }
  function partial(s, d) {
    if (d.length && !ready(d)) push(s, { kind: 'phone_partial', digits: d.length });
  }

  /* Своя форма платформы — по классу; чужая (лендинги парка со своей вёрсткой) — по наличию
     поля телефона. Иначе наблюдение видит только площадки на нашем стеке, а форменный
     трафик парка остаётся неизмеренным: за двое суток на десяти площадках 0024 набралось
     две форменные сессии. */
  function ownForm(f) { return !!f && !!f.matches && f.matches('form.js-form-callback'); }
  function phoneInput(f) {
    var el = f.querySelector('[name="phone"]');
    if (el) return el;
    var inputs = f.querySelectorAll('input');
    for (var i = 0; i < inputs.length; i++) if (phoneLike(inputs[i])) return inputs[i];
    return null;
  }
  function formOf(t) {
    if (!t || !t.closest) return null;
    var own = t.closest('form.js-form-callback');
    if (own) return own;
    var f = t.closest('form');
    return f && phoneInput(f) ? f : null;
  }
  function ensure(f) {
    if (!f.dataset.ismartSession) f.dataset.ismartSession = hex();
    /* Разметку чужой формы не трогаем: лишнее поле уехало бы в их приёмник заявок.
       Такие сессии сшиваются с заявкой по номеру, а не по ключу. */
    if (ownForm(f)) {
      var h = f.querySelector('input[name="idempotency_key"]');
      if (!h) {
        h = document.createElement('input');
        h.type = 'hidden';
        h.name = 'idempotency_key';
        f.appendChild(h);
      }
      h.value = f.dataset.ismartSession;
    }
    return session(f, 'form', f.dataset.ismartSession);
  }
  function formName(f) {
    var v = value(f, '[name="form_name"]') || value(f, '[name="source"]') || value(f, '[name="subject"]');
    if (v) return v.slice(0, 80);
    var box = f.closest('.js-modal, section, [data-section]');
    var h = box ? box.querySelector('h1, h2, h3, .modal__title') : null;
    return h ? String(h.textContent || '').trim().slice(0, 80) : '';
  }
  function trapState(f) {
    for (var i = 0; i < TRAP.length; i++) if (value(f, '[name="' + TRAP[i] + '"]')) return 'filled';
    return '';
  }
  function formFields(f) {
    var policy = f.querySelector('[name="policy"]');
    var tel = phoneInput(f);
    return {
      phone: value(f, '[name="phone_digits"]') || digitsOf(tel ? tel.value : ''),
      name: (value(f, '[name="name"]') || (nameField(f) ? nameField(f).value : '')).slice(0, 80),
      email: (value(f, '[name="email"]') || value(f, 'input[type="email"]')).slice(0, 120),
      policy: policy ? (policy.checked ? 'on' : 'off') : ''
    };
  }
  function isPhone(el) {
    if (!el) return false;
    if (el.name === 'phone') return true;
    var f = el.form || (el.closest ? el.closest('form') : null);
    return !!f && phoneInput(f) === el;
  }
  function isExtraField(el) { return !!el && (el.name === 'name' || el.name === 'email' || el.name === 'policy'); }

  function onStart(e) {
    var f = formOf(e.target);
    if (f) begin(ensure(f), { form: formName(f) });
  }
  ['pointerdown', 'focusin', 'keydown'].forEach(function (n) { document.addEventListener(n, onStart, true); });

  function onFormEdit(e) {
    var el = e.target;
    var f = formOf(el);
    if (!f || !(isPhone(el) || isExtraField(el))) return;
    var s = ensure(f);
    begin(s, { form: formName(f) });
    if (isPhone(el)) noteInput(s, e, digitsOf(el.value).length);
    else if (!s.ready && e.type === 'change') push(s, { kind: 'field', name: el.name, filled: el.type === 'checkbox' ? el.checked : !!el.value });
    var run = function () { evalTouch(s, formFields(f), trapState(f)); };
    if (e.type === 'input') schedule(s, run); else run();
  }
  ['input', 'change'].forEach(function (n) { document.addEventListener(n, onFormEdit, true); });
  document.addEventListener('focusin', function (e) {
    var f = formOf(e.target);
    if (f && isPhone(e.target)) focusPhone(ensure(f));
  }, true);
  document.addEventListener('focusout', function (e) {
    var f = formOf(e.target);
    if (!f || !isPhone(e.target)) return;
    var s = ensure(f);
    var fields = formFields(f);
    partial(s, fields.phone);
    evalTouch(s, fields, trapState(f));
  }, true);

  document.addEventListener('submit', function (e) {
    var f = e.target;
    if (!f || !f.matches || !f.matches('form')) return;
    if (!ownForm(f) && !phoneInput(f)) return;
    var s = ensure(f);
    begin(s, { form: formName(f) });
    state.last = s;
    var fields = formFields(f);
    var ev = { kind: 'attempt', fields: {}, trap: trapState(f), form: formName(f) };
    ['phone', 'name', 'email'].forEach(function (n) { if (fields[n]) ev.fields[n] = fields[n]; });
    if (fields.policy === 'off') ev.fields.policy = 'не отмечено';
    push(s, ev, true);
  }, true);

  document.addEventListener('pointerdown', function () { lastPointer = Date.now(); }, true);
  function watchForms() {
    if (!window.IntersectionObserver) return;
    var io = new IntersectionObserver(function (entries) {
      entries.forEach(function (en) {
        var f = en.target;
        if (!f.closest('.js-modal')) return;
        var s = ensure(f);
        if (en.isIntersecting) {
          if (s.open) return;
          s.open = true;
          push(s, { kind: 'open', channel: 'form', form: formName(f), open_type: Date.now() - lastPointer < 2000 ? 'click' : 'auto' });
        } else if (s.open) {
          s.open = false;
          push(s, { kind: 'close' }, active(s));
        }
      });
    }, { threshold: 0.3 });
    var seen = [];
    function scanForms() {
      var forms = document.querySelectorAll('form');
      for (var i = 0; i < forms.length; i++) {
        if (seen.indexOf(forms[i]) >= 0) continue;
        if (!ownForm(forms[i]) && !phoneInput(forms[i])) continue;
        seen.push(forms[i]);
        io.observe(forms[i]);
      }
    }
    scanForms();
    new MutationObserver(scanForms).observe(document.documentElement, { childList: true, subtree: true });
  }
  watchForms();

  /* Поле телефона ищем только по явным признакам. Ловец виджета берёт первый input,
     если ничего не подошло, — здесь так нельзя: сессию завёл бы любой свой iframe с полем
     (карта, оплата, чат), и в приёмник поехали бы чужие данные под видом виджета.
     У самого виджета CallTouch поле без типа, имени и подписи — узнаём его по маске:
     она начинается с плюса. Номер карты «0000 0000 0000 0000» так не выглядит. */
  function phoneLike(el) {
    if (el.type === 'tel' || el.getAttribute('inputmode') === 'tel') return true;
    var ph = el.placeholder || '';
    if (PHONE_RE.test(ph + ' ' + (el.name || '') + ' ' + (el.getAttribute('aria-label') || ''))) return true;
    return ph.charAt(0) === '+' && (ph.replace(/\D+/g, '').length + (ph.match(/[_#]/g) || []).length) >= 6;
  }
  /* Фрейм самого CallTouch — единственное место, где можно взять поле без явных признаков:
     у виджета Changan подписи нет вовсе (placeholder пустой, type=text, ни имени, ни маски),
     и сессии там не заводились — восемь виджетных заявок за двое суток против двух сессий. */
  function ctFrame(frame) {
    try { return /calltouch/i.test(String(frame.id || frame.name || '')); } catch (e) { return false; }
  }
  function phoneField(doc, trusted) {
    var inputs = doc.querySelectorAll('input');
    for (var i = 0; i < inputs.length; i++) {
      if (phoneLike(inputs[i])) return inputs[i];
    }
    if (!trusted) return null;
    for (var j = 0; j < inputs.length; j++) {
      var it = inputs[j];
      var type = (it.type || 'text').toLowerCase();
      if (type !== 'text' && type !== 'tel') continue;
      if (NAME_RE.test((it.placeholder || '') + ' ' + (it.name || ''))) continue;
      return it;
    }
    return null;
  }
  function nameField(doc) {
    var inputs = doc.querySelectorAll('input');
    for (var i = 0; i < inputs.length; i++) {
      var it = inputs[i];
      if (it.type !== 'tel' && NAME_RE.test((it.placeholder || '') + ' ' + (it.name || ''))) return it;
    }
    return null;
  }
  function widgetFields(doc, trusted) {
    var p = phoneField(doc, trusted);
    var n = nameField(doc);
    return { phone: digitsOf(p ? p.value : ''), name: n && n.value ? String(n.value).trim().slice(0, 80) : '', email: '', policy: '' };
  }
  var frames = [];
  function attachWidget(frame, doc) {
    if (doc.__ismartSession) return;
    var trusted = ctFrame(frame);
    var phone = function () { return phoneField(doc, trusted); };
    var s = session(doc, 'widget');
    s.frame = frame;
    frames.push(s);
    push(s, { kind: 'open', channel: 'widget', form: 'Виджет обратного звонка CallTouch',
      open_type: openedByClick() ? 'click' : 'auto', visitor: visitor(), vw: window.innerWidth });
    function touch() {
      if (s.started) return;
      s.started = true;
      focusPhone(s);
    }
    function edit(e) {
      var el = e.target;
      if (!el || el.tagName !== 'INPUT') return;
      touch();
      if (el === phone()) noteInput(s, e, digitsOf(el.value).length);
      var run = function () { evalTouch(s, widgetFields(doc, trusted), ''); };
      if (e.type === 'input') schedule(s, run); else run();
    }
    doc.addEventListener('input', edit, true);
    doc.addEventListener('change', edit, true);
    doc.addEventListener('focusin', function (e) { if (e.target === phone()) touch(); }, true);
    doc.addEventListener('focusout', function (e) {
      if (e.target !== phone()) return;
      var fields = widgetFields(doc, trusted);
      partial(s, fields.phone);
      evalTouch(s, fields, '');
    }, true);
    function submit() {
      if (!s.ready || s.submitted) return;
      s.submitted = true;
      state.last = s;
      push(s, { kind: 'widget_submit', seq: ++s.seq }, true);
    }
    /* Кнопка отправки виджета — не button и не ссылка, а div с классом вида styles__Button:
       прежний селектор её не находил, и нажатие в виджете до приёмника не доезжало.
       Ищем по роли, типу и классу, а промах закрывает перехват самого запроса ниже. */
    doc.addEventListener('click', function (e) {
      var t = e.target;
      if (!t || !t.closest) return;
      if (t.closest('input, textarea, label, a[href]')) return;
      if (t.closest('button, [type="submit"], [role="button"], [class*="utton"], [class*="btn" i]')) submit();
    }, true);
    doc.addEventListener('keydown', function (e) { if (e.key === 'Enter') submit(); }, true);
    doc.addEventListener('submit', submit, true);
    /* Надёжнее клика: сам запрос виджета в CallTouch. Вёрстка у него меняется без нашего
       ведома, а отправка заявки видна всегда. Обёртки прозрачные, отказ гасим — сломать
       виджет нельзя. */
    try {
      var w = frame.contentWindow;
      if (w && !w.__ismartHooked) {
        w.__ismartHooked = 1;
        var sent = function (url) { if (/calltouch|request|lead/i.test(String(url || ''))) submit(); };
        if (w.XMLHttpRequest && w.XMLHttpRequest.prototype) {
          var wopen = w.XMLHttpRequest.prototype.open;
          w.XMLHttpRequest.prototype.open = function (m, u) {
            try { if (String(m || '').toUpperCase() === 'POST') sent(u); } catch (err) {}
            return wopen.apply(this, arguments);
          };
        }
        if (w.fetch) {
          var wfetch = w.fetch;
          w.fetch = function (input, init) {
            try {
              var method = (init && init.method) || (input && input.method) || 'GET';
              if (String(method).toUpperCase() === 'POST') sent((input && input.url) || input);
            } catch (err) {}
            return wfetch.apply(this, arguments);
          };
        }
      }
    } catch (e) {}
  }
  function scanWidgets() {
    var list = document.querySelectorAll('iframe');
    for (var i = 0; i < list.length; i++) {
      var doc;
      try { doc = list[i].contentDocument; } catch (e) { continue; }
      if (doc && phoneField(doc, ctFrame(list[i]))) attachWidget(list[i], doc);
    }
    frames.forEach(function (s) {
      if (!s.closed && !document.documentElement.contains(s.frame)) {
        s.closed = true;
        push(s, { kind: 'close' }, active(s));
      }
    });
  }
  scanWidgets();
  new MutationObserver(scanWidgets).observe(document.documentElement, { childList: true, subtree: true });
  setInterval(scanWidgets, 2000);

  function report(outcome, error) {
    var s = state.last;
    if (!s) return;
    push(s, { kind: 'result', outcome: outcome, error: error || '' }, true);
    if (outcome !== 'sent') return;
    if (s.channel === 'form' && s.root.dataset) delete s.root.dataset.ismartSession;
    drop(s);
    state.last = null;
  }
  document.addEventListener('ismart:send-result', function (e) {
    var det = e.detail || {};
    report(det.outcome || '', det.error || '');
  }, true);
  function classify(status, text) {
    if (status >= 200 && status < 300) report('sent');
    else if (status === 0) report('network_error', 'нет ответа');
    else report('http_' + status, String(text || '').slice(0, 120));
  }
  var xopen = XMLHttpRequest.prototype.open;
  var xsend = XMLHttpRequest.prototype.send;
  XMLHttpRequest.prototype.open = function (m, u) {
    this.__ismartUrl = String(u || '');
    return xopen.apply(this, arguments);
  };
  XMLHttpRequest.prototype.send = function () {
    var x = this;
    if (x.__ismartUrl && SEND_RE.test(x.__ismartUrl)) {
      x.addEventListener('loadend', function () { classify(x.status, x.responseText); });
    }
    return xsend.apply(this, arguments);
  };
  if (window.fetch) {
    var ofetch = window.fetch;
    window.fetch = function (input) {
      var url = String((input && input.url) || input || '');
      var p = ofetch.apply(this, arguments);
      if (SEND_RE.test(url)) p.then(function (r) { classify(r.status); }, function () { classify(0); });
      return p;
    };
  }

  document.addEventListener('visibilitychange', function () {
    var kind = document.visibilityState === 'hidden' ? 'hide' : 'show';
    state.sessions.forEach(function (s) { if (active(s)) push(s, { kind: kind }); });
  });
  window.addEventListener('error', function (e) {
    var msg = String((e && e.message) || '').slice(0, 120);
    state.sessions.forEach(function (s) { if (active(s)) push(s, { kind: 'js_error', error: msg }); });
  });
  window.addEventListener('pagehide', function () {
    state.sessions.forEach(function (s) { if (active(s)) push(s, { kind: 'leave' }, true); });
  });
})();
</script>

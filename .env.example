# Полное описание всех параметров — docs/reference/env.md
# Правило именования: префикс = имя канала, у каждого есть _ENABLE и _TIMEOUT.
# Прежние имена (CT_, TG_, GS_, MAILER_, LEADS_API_) ещё читаются, но в новых
# деплойментах используем только эти.

# ── Приложение ───────────────────────────────────────────────────────────────
APP_ENV=development
APP_DEBUG=1
APP_DEFAULT_LANG=ru
# При Valet обязан совпадать с доменом стенда, иначе лого и картинки уедут на чужой хост.
# На проде: APP_ENV=production и реальный домен (или не задавать, если прокси отдаёт X-Forwarded-Proto).
APP_BASE_URL=https://example.test/
YANDEX_METRIC_ID=

# ── Почта ────────────────────────────────────────────────────────────────────
# На sel: smtp://sel.ismart.pro:25 — именно по этому имени, сертификат mailcow не
# покрывает localhost. Отправитель должен быть на нашем домене: example.com MTA отвергает.
# Канал выключен, если MAIL_TO пуст.
MAIL_DSN=smtp://sel.ismart.pro:25
MAIL_TO=
MAIL_FROM=api@ismart.pro
MAIL_FROM_NAME=
MAIL_SUBJECT_PREFIX=

# ── CallTouch ────────────────────────────────────────────────────────────────
# Счётчик подмены номеров (можно несколько через запятую)
CALLTOUCH_CLIENT_ID=
# Ключ виджета обратного звонка для кнопок сайта
CALLTOUCH_CALLBACK_WIDGET_ID=
# Канал заявок. ROUTE_KEY + TOKEN — автопрозвон; только SITE_ID — регистрация заявки без токена.
CALLTOUCH_ENABLE=false
CALLTOUCH_ROUTE_KEY=
CALLTOUCH_TOKEN=
CALLTOUCH_SITE_ID=
CALLTOUCH_TIMEOUT=10
# Роутинг по ДЦ: route_key:token,route_key:token
CT_ROUTES=

# ── Telegram ─────────────────────────────────────────────────────────────────
TELEGRAM_ENABLE=false
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_TIMEOUT=10

# ── Google Sheets ────────────────────────────────────────────────────────────
SHEETS_ENABLE=false
SHEETS_SPREADSHEET_ID=
SHEETS_SHEET_NAME=Заявки
SHEETS_CREDENTIALS_PATH=config/secrets/google-service-account.json
SHEETS_TIMEOUT=10

# ── Резервный сбор заявок ────────────────────────────────────────────────────
# Добавочный канал: почта, телеграм и таблицы остаются и включаются своими флагами.
# Где политика заказчика запрещает сторонние сервисы — просто не включаем.
# Подтверждение по домену; ключ нужен только вне нашего периметра (CDN, общий адрес).
RESCUE_ENABLE=false
RESCUE_URL=https://api.ismart.pro/v1/rescue
RESCUE_SITE=
RESCUE_KEY=
RESCUE_TIMEOUT=10

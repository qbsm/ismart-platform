# Application
APP_ENV=development
APP_DEBUG=1
APP_DEFAULT_LANG=ru
# Базовый URL сайта. На проде: APP_ENV=production и APP_BASE_URL=https://ваш-домен (или не задавать, если прокси отдаёт X-Forwarded-Proto).
APP_BASE_URL=https://example.test/

# Почта (Symfony Mailer) — канал mail в NotificationDispatcher
# DSN: smtp://user:pass@smtp.example.com:587  или  sendmail://default  или  native://default
# Канал disabled, если MAIL_TO пуст.
MAILER_DSN=smtp://localhost:25
MAIL_TO=info@example.com
MAIL_FROM=noreply@example.com
MAIL_FROM_NAME="Site Name"
MAIL_SUBJECT_PREFIX=[Site]

# CallTouch — канал calltouch (лид-трекинг). Канал disabled, пока CT_ENABLE=false или ключи пусты.
CT_ENABLE=false
CT_ROUTE_KEY=
CT_TOKEN=
CT_TIMEOUT=10

# Telegram — канал telegram (нотификации в чат). Один TG_CHAT_ID на deployment.
# Канал disabled, пока TG_ENABLE=false или ключи пусты.
TG_ENABLE=false
TG_BOT_TOKEN=
TG_CHAT_ID=
TG_TIMEOUT=10

# Google Sheets — канал google_sheets (лог заявок в таблицу).
# Канал disabled, пока GS_ENABLE=false / spreadsheet_id пуст / credentials не найдены.
# Как получить credentials — см. config/secrets/README.md.
GS_ENABLE=false
GS_SPREADSHEET_ID=
GS_SHEET_NAME=Заявки
GS_CREDENTIALS_PATH=config/secrets/google-service-account.json
GS_TIMEOUT=10

# Analytics (опционально)
# YANDEX_METRIC_ID=12345678

# CSP целиком строкой — переопределяет базовую политику ядра.
# Пусто = базовая (self + любой https для скриптов/стилей/картинок).
# APP_CSP="default-src 'self'; script-src 'self' 'unsafe-inline' https://mc.yandex.ru; ..."
